# Copy to .env next to docker-compose.yml and fill in. Don't use a "$" in any value.
DATA_SOURCE=sheet
SHEET_ID=paste-the-google-sheet-id
TAB_NAME=Playlist Data

# staff login in front of the whole app
APP_USER=staff
APP_PASS=change-me

# hidden admin page. No password = admin page is off. Pick an obscure path.
ADMIN_PATH=/change-this-path
ADMIN_PASSWORD=a-long-passphrase
