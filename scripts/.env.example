# Copy to .env next to trailer_automation.py (or run make_env.py to build it from your old script).
# Never commit the real .env. Don't put quotes around values. Lists like FTP_PROJECTORS stay in the script.
IMAP_USER=
IMAP_PASSWORD=
FTP_USER=
FTP_PASSWORD=
SHEET_URL=
SHEET_TOKEN=
TMDB_TOKEN=
DISCORD_WEBHOOK=
LOG_WEBHOOK=
KUMA_PUSH_URL=
ADS_TARGET_ROOT=
ADS_ARCHIVE_ROOT=

# trailer keep rule: ask the playlist app which trailers are in a running or scheduled playlist
# PLAYLIST_APP_URL is the app's address with no trailing slash, PLAYLIST_APP_TOKEN matches API_TOKEN in the app's .env
PLAYLIST_APP_URL=
PLAYLIST_APP_TOKEN=

# launcher.py settings (optional)
# LAUNCHER_REF=main
# LAUNCHER_UPDATE=1
